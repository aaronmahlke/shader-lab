{
  "name": "shader-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/core build && bun run --cwd apps/web dev",
    "build": "bun run --cwd packages/core build && bun run --cwd apps/web build",
    "generate": "bun run --cwd apps/web generate",
    "preview": "bun run --cwd apps/web preview",
    "core:build": "bun run --cwd packages/core build",
    "test": "bun run --cwd packages/core test",
    "db:generate": "bun run --cwd apps/web db:generate",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "migrate": "bun run --cwd apps/web migrate",
    "db:push": "bun run --cwd apps/web db:push",
    "db:studio": "bun run --cwd apps/web db:studio"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
