{
  "name": "@shader-lab/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../packages/core build && bun --env-file=../../.env --env-file=.env nuxt dev",
    "build": "bun run --cwd ../../packages/core build && bun --env-file=../../.env --env-file=.env nuxt build",
    "generate": "bun --env-file=../../.env --env-file=.env nuxt generate",
    "preview": "bun --env-file=../../.env --env-file=.env nuxt preview",
    "db:generate": "drizzle-kit generate --config=server/database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=server/database/drizzle.config.ts",
    "migrate": "bun run db:migrate",
    "db:push": "drizzle-kit push --config=server/database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=server/database/drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@heroicons/vue": "^2.2.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify/vue": "^5.0.1",
    "@napi-rs/canvas": "^0.1.92",
    "@shader-lab/core": "workspace:*",
    "@vueuse/core": "^14.0.0",
    "drizzle-orm": "^1.0.0-beta.15-859cf75",
    "mediabunny": "^1.34.4",
    "motion-v": "^2.3.0",
    "nuxt": "^4.3.0",
    "nuxt-auth-utils": "^0.5.29",
    "postgres": "^3.4.8",
    "reka-ui": "^2.6.0",
    "uuidv7": "^1.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.12.1",
    "@tailwindcss/vite": "^4.1.18",
    "drizzle-kit": "^1.0.0-beta.15-859cf75",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-plugin-glsl": "^1.3.0"
  }
}
