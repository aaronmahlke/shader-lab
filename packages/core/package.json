  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test src/"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.92",
    "gl": "^9.0.0-rc.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
